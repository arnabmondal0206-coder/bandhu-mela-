rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidImage() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
    }

    function isValidMedia() {
      return request.resource.size <= 50 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)') ||
          request.resource.contentType.matches('video/(mp4|webm|quicktime)')
        );
    }

    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) && isValidImage();
    }

    match /covers/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) && isValidImage();
    }

    match /posts/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) && isValidMedia();
    }

    match /stories/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) && isValidMedia();
    }

    match /reels/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) && isValidMedia();
    }

    match /chats/{conversationId}/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) && isValidMedia();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
