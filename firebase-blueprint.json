{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public user profile data visible to authenticated users (PII-free).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 3, "maxLength": 30, "pattern": "^[a-z0-9_]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "bio": { "type": "string", "maxLength": 300 },
        "location": { "type": "string", "maxLength": 80 },
        "workOrBioTag": { "type": "string", "maxLength": 80 },
        "photoURL": { "type": "string", "maxLength": 2000 },
        "coverURL": { "type": "string", "maxLength": 2000 },
        "profileVisibility": { "type": "string", "enum": ["public", "friends"] },
        "messagePrivacy": { "type": "string", "enum": ["everyone", "friends"] },
        "showOnlineStatus": { "type": "boolean" },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "postsCount": { "type": "number" },
        "isSuspended": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid", "username", "displayName", "bio", "location", "workOrBioTag",
        "photoURL", "coverURL", "profileVisibility", "messagePrivacy", "showOnlineStatus",
        "followersCount", "followingCount", "postsCount", "isSuspended", "createdAt", "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII and role metadata accessible only to the owner or an admin.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 120 },
        "phoneNumber": { "type": "string", "maxLength": 24 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "phoneNumber", "role", "createdAt", "updatedAt"]
    },
    "SavedPost": {
      "title": "SavedPost",
      "description": "Bookmarked post reference for a user.",
      "type": "object",
      "properties": {
        "postId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "userId", "createdAt"]
    },
    "UserPresence": {
      "title": "UserPresence",
