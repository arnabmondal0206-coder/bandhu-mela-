        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "streamId", "fromUid", "toUid", "type", "payload", "createdAt"]
    },
    "CallSession": {
      "title": "CallSession",
      "description": "1-to-1 voice or video WebRTC call session.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
