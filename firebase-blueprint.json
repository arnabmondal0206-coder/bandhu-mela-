      "required": [
        "id", "isGroup", "groupName", "groupPhoto", "createdBy",
        "participantA", "participantB", "participants",
        "participantAName", "participantAPhoto", "participantBName", "participantBPhoto",
        "lastMessage", "lastSenderId", "createdAt", "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
