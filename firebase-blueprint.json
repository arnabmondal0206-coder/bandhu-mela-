        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "isOnline": { "type": "boolean" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "isOnline", "lastSeen", "updatedAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Community feed post or short video reel.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "authorUsername": { "type": "string", "minLength": 3, "maxLength": 30 },
        "authorPhoto": { "type": "string", "maxLength": 2000 },
        "caption": { "type": "string", "maxLength": 2200 },
        "hashtags": { "type": "array", "description": "Bounded list of up to 15 hashtags." },
        "mediaUrl": { "type": "string", "maxLength": 2000 },
        "mediaType": { "type": "string", "enum": ["text", "image", "video", "reel"] },
        "aspectRatio": { "type": "string", "enum": ["1:1", "4:3", "9:16", "16:9"] },
