        "commentsCount": { "type": "number" },
        "sharesCount": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "hidden"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "authorId", "authorName", "authorUsername", "authorPhoto",
        "caption", "hashtags", "mediaUrl", "mediaType", "aspectRatio",
        "likesCount", "commentsCount", "sharesCount", "status", "createdAt", "updatedAt"
      ]
    },
    "Story": {
      "title": "Story",
      "description": "24-hour ephemeral photo or video story.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "authorUsername": { "type": "string", "minLength": 3, "maxLength": 30 },
        "authorPhoto": { "type": "string", "maxLength": 2000 },
        "mediaUrl": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "caption": { "type": "string", "maxLength": 300 },
        "viewersCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "authorId", "authorName", "authorUsername", "authorPhoto",
        "mediaUrl", "mediaType", "caption", "viewersCount", "createdAt", "expiresAt"
      ]
    },
    "PostLike": {
      "title": "PostLike",
      "description": "User like record on a post.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "postId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "postId", "createdAt"]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "Comment on a feed post or reel.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "postId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "authorUsername": { "type": "string", "minLength": 3, "maxLength": 30 },
        "authorPhoto": { "type": "string", "maxLength": 2000 },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "postId", "authorId", "authorName", "authorUsername", "authorPhoto", "text", "createdAt"]
    },
    "Follow": {
      "title": "Follow",
      "description": "Directional follow relationship.",
      "type": "object",
      "properties": {
        "followerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
