      },
      "required": ["viewerId", "streamId", "viewerName", "joinedAt"]
    },
    "WebRTCSignal": {
      "title": "WebRTCSignal",
      "description": "WebRTC SDP/ICE signaling packet between host and viewer.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
